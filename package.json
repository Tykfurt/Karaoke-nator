{
  "name": "karaoke-app",
  "version": "1.0.0",
  "description": "Karaoke-inador: cola de canciones de YouTube en red local con control de admin",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --targets node22-win-x64 --output dist/KaraokeApp.exe",
    "build:all": "pkg . --targets node22-win-x64,node22-linux-x64,node22-macos-x64 --output dist/KaraokeApp"
  },
  "dependencies": {
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "ws": "^8.17.0"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  }
}